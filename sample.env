# Default settings for the Savant RTSP source adapter container.
# Loaded by AdapterSettings (pydantic-settings) and used as the default
# values for AdapterConfig fields when a SourceCommand doesn't override them.

ADAPTER_IMAGE=ghcr.io/insight-platform/savant-adapters-gstreamer:0.6.0
ADAPTER_ENTRYPOINT=/opt/savant/adapters/gst/sources/rtsp.sh
ADAPTER_NETWORK=host
ADAPTER_ZMQ_ENDPOINT=dealer+connect:ipc:///tmp/zmq-sockets/input-video.ipc
# Comma-separated list of "host_path:container_path[:mode]" bind mounts
ADAPTER_VOLUMES=/tmp/zmq-sockets:/tmp/zmq-sockets

# Kafka settings
KAFKA_COMMANDS_TOPIC=source-commands
KAFKA_STATUS_TOPIC=source-events
KAFKA_BOOTSTRAP_SERVER=localhost:29092
KAFKA_GROUP_ID=source-management

# Redis settings
REDIS_HOST=localhost
REDIS_PORT=6379

# General settings
STATE_FILE=active_sources.json
RETRY_SECONDS=5
CONTAINER_NAME_PREFIX=source-rtsp-
